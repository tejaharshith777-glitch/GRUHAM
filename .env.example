# Optional. Leave everything unset and the app runs in offline demo mode
# (local database + built-in AI engine). Everything below is optional.

# Google Gemini key - used by base44.integrations.Core.InvokeLLM()
VITE_GEMINI_API_KEY=

# Set to "online" to generate images through a public text-to-image endpoint
# instead of the offline curated render set.
VITE_IMAGE_MODE=offline
