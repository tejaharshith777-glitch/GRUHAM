# GRUHAM Environment Configuration
# Copy this file to .env and fill in your Firebase & Gemini API credentials.

# -----------------------------------------------------------------------------
# FIREBASE CONFIGURATION (Frontend Client Credentials)
# Obtain these values from Firebase Console -> Project Settings -> General -> Web App
# -----------------------------------------------------------------------------
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# -----------------------------------------------------------------------------
# AI ENGINE CONFIGURATION (Server-Side Only - Vercel Serverless Functions)
# Obtain from Google AI Studio (https://aistudio.google.com/)
# Set this in Vercel Dashboard -> Project Settings -> Environment Variables
# DO NOT prefix with VITE_ or REACT_APP_ (prevents browser bundle exposure)
# -----------------------------------------------------------------------------
GEMINI_API_KEY=

# Set to "online" to generate images through a public text-to-image endpoint
# instead of the offline curated render set.
VITE_IMAGE_MODE=offline
